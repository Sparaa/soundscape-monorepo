# Soundscape settings. Copy to .env (Windows: copy .env.example .env) and edit. Everything has a working default.

# ---- GPU ------------------------------------------------------------------------------------------
# Which GPU the sidecars and Ollama use (`nvidia-smi -L` prints the UUIDs). Empty = the first/only GPU.
SOUNDSCAPE_GPU_UUID=
# VRAM YuE2 may use. 20 on a 24 GB+ card. On a 16 GB card set 12 (smaller decoder tiles, slightly slower, no OOM).
MUSIC_BUDGET_GIB=20

# ---- Writer LLM (OpenAI-compatible chat endpoint) ---------------------------------------------------
# Default = the bundled Ollama (`--profile llm`). The writing task is easy; a 7B model is plenty.
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=local
# Bundled Ollama only: 0 = unload the model right after each call (frees VRAM for YuE2). "10m" on 24 GB+ cards.
OLLAMA_KEEP_ALIVE=0
# Alternatives (then start WITHOUT --profile llm):
#   Ollama installed on the Windows/Linux host:  LLM_BASE_URL=http://host.docker.internal:11434/v1  (and set OLLAMA_HOST=0.0.0.0 for it)
#   LM Studio on the host:                       LLM_BASE_URL=http://host.docker.internal:1234/v1   LLM_MODEL=<name shown in LM Studio>
#   Hosted API:                                  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini  LLM_API_KEY=sk-...

# ---- Sidecars (defaults = the compose services; point elsewhere to share sidecars with another app) --
YUE2_URL=http://yue2:3015
SHEETSAGE_URL=http://sheetsage:3016
CLIPGRAB_URL=http://clipgrab:3014

# ---- Storage / ports ---------------------------------------------------------------------------------
# Saved songs, seeds and the SQLite database (audio persists on disk by design). Relative to this folder.
LIBRARY_DIR=./library
# Keep API_PORT at 3021 — the web build hard-codes http://localhost:3021 for the browser. WEB_PORT is free to change.
API_PORT=3021
WEB_PORT=3020
